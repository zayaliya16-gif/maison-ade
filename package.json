{
  "name": "maison-ade",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "node --conditions=react-server --env-file-if-exists=.env.local --test --test-concurrency=1 tests/*.test.js",
    "db:check": "node --env-file=.env.local scripts/check-db.mjs",
    "db:seed": "node --env-file=.env.local scripts/seed.mjs",
    "msg:test": "node --env-file=.env.local scripts/test-message.mjs",
    "test:e2e": "next build && playwright test",
    "token:extend": "node --env-file=.env.local scripts/long-lived-token.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.2",
    "next": "^15.5.29",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5"
  },
  "engines": {
    "node": "22.x"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
