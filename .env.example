# Copy this file to .env.local and fill in the values. Never commit .env.local.
# Supabase dashboard > Project Settings > API Keys

SUPABASE_URL=https://your-project-ref.supabase.co
# The "secret" key (sb_secret_...) or the legacy "service_role" key. Server only: never share it.
SUPABASE_SECRET_KEY=

# Shared password for the staff diary at /staff (at least 12 characters)
STAFF_PASSWORD=

# Email via Resend (resend.com > API Keys). Without your own domain, Resend only delivers to your own Resend email.
RESEND_API_KEY=
# Optional: who emails come from (needs a verified domain in Resend). Default: Maison Adé <onboarding@resend.dev>
EMAIL_FROM=

# WhatsApp via Meta Cloud API (developers.facebook.com > your app > WhatsApp > API Setup)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Optional: "on" once your message templates are approved in Meta (needed to message people who haven't written in 24h)
WHATSAPP_USE_TEMPLATES=
# Optional: Meta API version (default v25.0)
WHATSAPP_API_VERSION=
